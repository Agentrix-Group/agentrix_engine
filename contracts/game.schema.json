{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameManifest",
  "description": "Schema for game manifests and rulesets in Agentrix",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the game"
    },
    "name": {
      "type": "string",
      "description": "Human-readable game title"
    },
    "version": {
      "type": "string",
      "description": "Semantic version string"
    },
    "description": {
      "type": "string",
      "description": "Detailed gameplay description and rules"
    },
    "min_players": {
      "type": "integer",
      "minimum": 1
    },
    "max_players": {
      "type": "integer",
      "minimum": 1
    },
    "max_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "grid_width": {
      "type": "integer",
      "minimum": 1
    },
    "grid_height": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["id", "name", "version", "min_players", "max_players", "max_ticks"]
}
