{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentrix.dev/schemas/games/conformance-counter/1.0.0/observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tick", "selfCounter", "target"],
  "properties": {
    "schemaVersion": {"const": "conformance-observation/1"},
    "tick": {"type": "integer", "minimum": 0},
    "selfCounter": {"type": "integer", "minimum": 0},
    "target": {"type": "integer", "minimum": 1, "maximum": 1000}
  }
}
